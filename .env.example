# Copy to .env and edit. Docker Compose reads it automatically.

# Which address to listen on. 127.0.0.1 means "this computer only" (safe default).
# For phones, use a private address such as your Tailscale IP (run: tailscale ip -4).
BIND_IP=127.0.0.1
PORT=5056

# Your timezone, so "expires today" means YOUR today. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# What NFC tag links should start with. Use the same address your phones use, with the IP, not a name.
PUBLIC_BASE_URL=http://localhost:5056

# Items expiring within this many days get the amber warning.
EXPIRY_WARN_DAYS=3
